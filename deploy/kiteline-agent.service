[Unit]
Description=Kiteline device agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Set the project account, home directory, PATH and an installed UTF-8 locale.
User=YOUR_PROJECT_USER
WorkingDirectory=/home/YOUR_PROJECT_USER
Environment=HOME=/home/YOUR_PROJECT_USER
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
EnvironmentFile=-/etc/kiteline-agent.env
ExecStart=/usr/local/bin/kiteline-agent run
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
