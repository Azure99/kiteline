diff --git a/input.c b/input.c
--- a/input.c
+++ b/input.c
@@ -2419,6 +2419,14 @@ input_exit_osc(struct input_ctx *ictx)
 	case 133:
 		input_osc_133(ictx, p);
 		break;
+	case 7501:
+		if (wp != NULL && strcmp(p, "?") == 0 &&
+		    options_get_number(wp->options, "program-status")) {
+			input_reply(ictx, "\033]7501;?:"
+			    "states=idle,working,done,blocked,error:"
+			    "kinds=permission,question,auth\033\\");
+		}
+		break;
 	default:
 		log_debug("%s: unknown '%u'", __func__, option);
 		break;
