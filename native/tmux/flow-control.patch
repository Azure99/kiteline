+int
+control_window_blocked(struct window *w)
+{
+	struct client *c;
+	struct control_state *cs;
+
+	TAILQ_FOREACH(c, &clients, entry) {
+		if (!(c->flags & CLIENT_CONTROL_FLOW) || c->session == NULL ||
+		    !session_has(c->session, w))
+			continue;
+		cs = c->control_state;
+		if (EVBUFFER_LENGTH(cs->write_event->output) >= CONTROL_BUFFER_LOW ||
+		    !TAILQ_EMPTY(&cs->all_blocks))
+			return (1);
+	}
+	return (0);
+}
