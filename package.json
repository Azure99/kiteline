{
  "name": "kiteline",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "22.23.3"
  },
  "scripts": {
    "build": "tsc -b && pnpm --filter @kiteline/web build",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && pnpm --filter @kiteline/web typecheck",
    "lint": "eslint server agent terminal-recorder shared web scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --maxWorkers=2",
    "native:build": "node scripts/build-native.mjs",
    "package": "node scripts/package.mjs",
    "images": "node scripts/images.mjs",
    "dev": "node scripts/dev.mjs",
    "server": "node server/dist/main.js",
    "agent": "node agent/dist/main.js"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "@types/proper-lockfile": "4.1.4",
    "@types/proxy-from-env": "1.0.4",
    "@types/ws": "8.18.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
